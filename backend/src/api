export const FISH_API_URL = 'https://marcconrad.com/uob/fish/api.php?out=json&base64=yes';

interface FishApiPayload {
  question: string;
  fish: number;
  chest: number;
}

export interface FishPuzzle {
  imageUrl: string;
  solution: number;
}

export type FishApiErrorKind = 'connection' | 'invalid-response';

export class FishApiError extends Error {
  constructor(
    message: string,
    readonly kind: FishApiErrorKind,
  ) {
    super(message);
    this.name = 'FishApiError';
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value);
}

function parsePuzzle(payload: unknown): FishPuzzle {
  if (!isRecord(payload)) {
    throw new FishApiError('The puzzle service returned an unexpected response.', 'invalid-response');
  }

  const { question, fish, chest } = payload;
  if (
    typeof question !== 'string' ||
    !Number.isInteger(fish) ||
    typeof fish !== 'number' ||
    fish < 0 ||
    fish > 9 ||
    typeof chest !== 'number' ||
    !Number.isInteger(chest)
  ) {
    throw new FishApiError('The puzzle service returned an incomplete puzzle.', 'invalid-response');
  }

  if (question.startsWith('data:image/')) {
    return { imageUrl: question, solution: fish };
  }

  // The documented base64 response may contain the raw image payload rather
  // than a data-URL prefix. Fish puzzles are PNG images.
  if (/^[A-Za-z0-9+/]+=*$/.test(question) && question.length > 100) {
    return { imageUrl: `data:image/png;base64,${question}`, solution: fish };
  }

  let image: URL;
  try {
    image = new URL(question);
  } catch {
    throw new FishApiError('The puzzle image address is invalid.', 'invalid-response');
  }
  if (image.protocol !== 'https:') {
    throw new FishApiError('The puzzle image must use a secure address.', 'invalid-response');
  }

  return { imageUrl: image.href, solution: fish };
}

export async function fetchFishPuzzle(signal?: AbortSignal): Promise<FishPuzzle> {
  let response: Response;
  try {
    response = await fetch(FISH_API_URL, {
      headers: { Accept: 'application/json' },
      signal,
    });
  } catch (error) {
    if (error instanceof DOMException && error.name === 'AbortError') throw error;
    throw new FishApiError('Could not connect to the Fish Puzzle service.', 'connection');
  }

  if (!response.ok) {
    throw new FishApiError(`The puzzle service responded with ${response.status}.`, 'connection');
  }

  let payload: unknown;
  try {
    payload = await response.json() as unknown;
  } catch {
    throw new FishApiError('The puzzle service returned unreadable data.', 'invalid-response');
  }
  return parsePuzzle(payload);
}

export function preloadPuzzleImage(imageUrl: string): Promise<void> {
  return new Promise((resolve, reject) => {
    const image = new Image();
    image.onload = () => resolve();
    image.onerror = () => reject(new FishApiError('The puzzle image could not be loaded.', 'connection'));
    image.src = imageUrl;
  });
}
